<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>dev.disputeagent</groupId>
    <artifactId>investigator-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>investigator</name>
    <description>Dispute investigation agent: hexagonal, Claude behind an LlmPort, tools over MCP</description>

    <modules>
        <module>domain</module>
        <module>application</module>
        <module>adapters</module>
        <module>bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Report deprecated API use on every build; SDK bumps deprecate things (MCP SDK 2.2.0 did). -->
        <maven.compiler.showDeprecation>true</maven.compiler.showDeprecation>
        <!-- Pins verified in docs/ROADMAP.md. An SDK bump must pass the tools/list contract tests and the
             deterministic eval suite; an Anthropic SDK major bump re-records fixtures (ADR 0001). -->
        <anthropic-java.version>3.12.0</anthropic-java.version>
        <mcp.version>2.2.0</mcp.version>
        <!-- The JSON Schema validator mcp-json-jackson3 2.2.0 uses for tool inputs; keep the two in step so the
             client and the servers validate with the same library and version. -->
        <json-schema-validator.version>3.0.9</json-schema-validator.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <testcontainers-bom.version>2.0.5</testcontainers-bom.version>
        <!-- kafka-clients' compression codecs, raised to the first patch that fixes a HIGH finding in the image scan
             (task 2.16); drop each override once kafka-clients brings that version or newer itself. -->
        <lz4-java.version>1.14.1</lz4-java.version>
        <snappy-java.version>1.1.10.12</snappy-java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.disputeagent</groupId>
                <artifactId>investigator-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.disputeagent</groupId>
                <artifactId>investigator-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.disputeagent</groupId>
                <artifactId>investigator-adapters</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.anthropic</groupId>
                <artifactId>anthropic-java</artifactId>
                <version>${anthropic-java.version}</version>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>${json-schema-validator.version}</version>
            </dependency>
            <!-- Every Resilience4j module at one version (ADR 0008; the adapters use the core modules directly). -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>${snappy-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
