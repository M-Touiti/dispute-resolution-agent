# Copy to .env and fill in. The only secret the repository needs.
ANTHROPIC_API_KEY=

# Model ids live in configuration, never in code (ADR 0001).
INVESTIGATOR_MODEL=claude-opus-5-5
INVESTIGATOR_EFFORT=medium
TRIAGE_MODEL=claude-haiku-5-5
TRIAGE_EFFORT=low
GRADER_MODEL=claude-opus-5-5

# LLM port adapter: anthropic | recording | replay
LLM_ADAPTER=replay

# Local infrastructure (docker compose defaults)
POSTGRES_URL=jdbc:postgresql://localhost:5432/disputes
POSTGRES_USER=disputes
POSTGRES_PASSWORD=disputes
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MCP servers (Streamable HTTP)
LEDGER_MCP_URL=http://localhost:8081/mcp
POLICY_MCP_URL=http://localhost:8082/mcp
ACTIONS_MCP_URL=http://localhost:8083/mcp

# Approval tokens (ADR 0005, docs/approval-token.md): Ed25519 keys, generated by the compose stack on first start
# and mounted as files; never set here. To run the investigator on the host against the stack, point it at a copy
# of the keys with APPROVAL_KEYS_DIR, or leave it unset and approvals answer 503.
# APPROVAL_KEYS_DIR=/path/to/approval-keys

# The reviewer API's key (X-Reviewer-Key), a stand-in for single sign-on. Compose defaults to local-reviewer-key.
REVIEWER_API_KEY=local-reviewer-key

# Synthetic data seed
DATA_SEED=20261101
